@php
    // PRD Navigation Structure
    $navItems = [
        ['type' => 'nav-home', 'text' => __t('nav.home'), 'route' => 'home', 'icon' => 'home', 'show' => site('nav_show_home', '1') == '1'],
        ['type' => 'nav-products', 'text' => __t('nav.products'), 'route' => 'shop.index', 'icon' => 'basket', 'show' => site('nav_show_products', '1') == '1'],
    ];

    if (site('nav_show_categories', '1') == '1') {
        $visibleCategories = \App\Models\Catalog\Category::where('status', 'active')
            ->whereNull('parent_id')
            ->orderBy('order')
            ->limit(6)
            ->get();
        foreach ($visibleCategories as $category) {
            $navItems[] = [
                'type' => 'nav-category',
                'text' => $category->name,
                'route' => 'shop.category',
                'params' => ['slug' => $category->slug],
                'show' => true,
                'icon' => 'category'
            ];
        }
    }
@endphp

<!-- PRD Compliant Mobile-First Header -->
