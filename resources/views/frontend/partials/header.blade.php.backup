                    <a href="{{ route('shop.index') }}" class="flex items-center gap-3 px-5 py-3 text-sm rounded-lg bg-primary text-white">
                        <span class="material-symbols-outlined text-lg mr-1">{{ $item['icon'] }}</span> {{ $item['text'] }}
                    </a>
                @else
                    @if($item['params'] ?? [])
                        <a href="{{ route($item['route'], ...collect($item['params']->all()) }}" class="flex items-center gap-3 px-5 py-3 text-sm rounded-lg bg-primary text-white">
                            <span class="material-symbols-outlined text-lg mr-1">{{ $item['icon'] }}</span> {{ $item['text'] }}
                        </a>
                    @else
                        <a href="{{ route('page.show', ['slug' => $item['slug']]) }}" class="flex items-center gap-3 px-5 py-3 text-sm rounded-lg bg-primary text-white">
