        @php $mobileNavItems = array_merge(
            [['icon' => 'home', 'text' => __t('nav.home'), 'route' => 'home']], 
            array_map(function($cat) { return ['icon' => 'category', 'text' => $cat->name, 'route' => 'shop.category', 'params' => ['slug' => $cat->slug]]}, 
            \App\Models\Catalog\Category::where('status', 'active')->whereNull('parent_id')->limit(6)->get()->all()
        ); @endphp
